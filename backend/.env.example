# Copy this file to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=

# Optional: send traces of every agent run to LangSmith (smith.langchain.com).
# Leave empty to keep tracing off. Traces include prompts, receipt photos and names.
LANGSMITH_API_KEY=

# Optional: Google sign-in (history and saved friends). The OAuth client ID from Google Cloud.
GOOGLE_CLIENT_ID=
# Any long random string; keeps people signed in across restarts. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# The email shown on the privacy page for questions and deletion requests.
CONTACT_EMAIL=

# Optional: a Postgres database instead of the local split_genie.db file (the deployed app uses
# Neon). Locally, leave it empty.
DATABASE_URL=
